{% extends "../../partials/layout.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "partials/probation-office-register/probationOfficeCoreDetailsCard.njk" import probationOfficeCoreDetailsCard %}
{% from "partials/probation-office-register/probationOfficeAreaDetailsCard.njk" import probationOfficeAreaDetailsCard %}
{% from "partials/addressesCard.njk" import addressesCard %}
{% from "partials/phoneNumbersCard.njk" import phoneNumbersCard %}
{% from "partials/emailAddressesCard.njk" import emailAddressesCard %}

{% set pageTitle = applicationName + " - Probation Office Details" %}

{% block content %}
  {{ govukBackLink({
    text: "Back",
    href: "/probation-office-register"
  }) }}

  <!--suppress HtmlUnknownTarget -->
  <main class="app-container govuk-body">
    <h1 class="govuk-heading-l">{{ probationOffice.probationOfficeName }}</h1>

    {% if action == 'CREATED' %}
      <div data-qa="confirm-created" class="govuk-panel govuk-panel--confirmation">
        <div class="govuk-panel__body">
          Probation office has been added successfully
        </div>
      </div>
    {% endif %}
    {% if action == 'UPDATED' %}
      <div data-qa="confirm-updated" class="govuk-panel govuk-panel--confirmation">
        <div class="govuk-panel__body">
          Probation office has been updated successfully
        </div>
      </div>
    {% endif %}

  <div>
    <h2 class="flush-left govuk-heading-m govuk-grid-column-one-half">Probation office details</h2>
  </div>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{  probationOfficeCoreDetailsCard({ probationOffice: probationOffice }) }}
    </div>
    <div class="govuk-grid-column-two-thirds">
      {{  probationOfficeAreaDetailsCard({ probationOffice: probationOffice }) }}
    </div>
    <div class="govuk-grid-column-two-thirds">
      {{  addressesCard({ addresses: probationOffice.addresses, id: probationOffice.probationOfficeId, baseRegisterUrl: "/probation-office-register" }) }}
    </div>
    <div class="govuk-grid-column-two-thirds">
      {{  phoneNumbersCard({ phoneNumbers: probationOffice.phoneNumbers, id: probationOffice.probationOfficeId, baseRegisterUrl: "/probation-office-register", deleteHidden: true }) }}
    </div>
    <div class="govuk-grid-column-two-thirds">
      {{  emailAddressesCard({ emailAddresses: probationOffice.emailAddresses, id: probationOffice.probationOfficeId, baseRegisterUrl: "/probation-office-register", deleteHidden: true }) }}
    </div>
  </div>
  </main>

{% endblock %}
