{% extends "../../partials/layout.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "moj/components/filter/macro.njk" import mojFilter %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}

{% set pageTitle = applicationName + " - Court Register" %}

{% set filterOptionsHtml %}
    <form id="filter-form" action="/court-register" novalidate>
        {{ govukInput( filter.textSearch | toTextSearchInput ) }}
        {{ govukRadios( filter.active | toActiveFilterRadioButtons ) }}
        {{ govukCheckboxes( filter.courtTypeCodes | toCourtTypeCheckboxes ) }}
    </form>
{% endset %}


{% block content %}
    <!--suppress HtmlUnknownTarget -->
    <div class="govuk-width-container">
        {{ govukBackLink({
            text: "Back",
            href: "/"
        }) }}

        <main class="app-container govuk-body">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-full">
                    <h1 class="govuk-heading-xl">Court Register</h1>
                </div>
            </div>

            <div class="moj-filter-layout">
                <div class="moj-filter-layout__filter">{{ mojFilter(filterOptionsHtml | toCourtListFilter(filter, filterOptionsHtml)) }}</div>

                <div class="moj-filter-layout__content">

                    <div class="govuk-grid-row">
                        <div class="govuk-grid-column-full">
                            <div class="moj-action-bar__filter"></div>
                        </div>
                    </div>

                    <div class="govuk-grid-row">
                        <div class="govuk-grid-column-full">
                            {% if courts.length %}
                                <table class="govuk-table incidents govuk-!-margin-bottom-3" data-qa="courts">
                                    <thead class="govuk-table__head">
                                    <tr class="govuk-table__row">
                                        <th class="govuk-table__header govuk-!-width-one-fifth" scope="col">Code</th>
                                        <th class="govuk-table__header govuk-!-width-one-fifth" scope="col">Name</th>
                                        <th class="govuk-table__header govuk-!-width-one-fifth" scope="col">Active</th>
                                        <th class="govuk-table__header govuk-!-width-one-fifth" scope="col">Type</th>
                                    </tr>
                                    </thead>

                                    <tbody class="govuk-table__body">
                                    {% for court in courts %}
                                        <tr class="govuk-table__row">
                                            <td class="govuk-table__cell">{{ court.id }}</td>
                                            <td class="govuk-table__cell"><a href="/court-register/details?id={{ court.id }}"
                                                                             class="govuk-link govuk-link--no-visited-state">{{ court.name }}</a>
                                            </td>
                                            <td class="govuk-table__cell">
                                                {% if court.active %}
                                                    Active
                                                {% else %}
                                                    Inactive
                                                {% endif %}
                                            </td>
                                            <td class="govuk-table__cell">
                                                {{ court.type }}
                                            </td>
                                        </tr>
                                    {% endfor %}

                                    </tbody>
                                </table>
                            {% else %}
                                <p data-qa=no-courts class="govuk-body">There are no courts</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

{% endblock %}

{% block bodyEnd %}
    {{ super() }}
{% endblock %}
