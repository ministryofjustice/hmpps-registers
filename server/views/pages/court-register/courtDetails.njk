{% extends "../../partials/layout.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "partials/court-register/courtCoreDetailsCard.njk" import courtCoreDetailsCard %}
{% from "partials/court-register/courtAreaDetailsCard.njk" import courtAreaDetailsCard %}
{% from "partials/addressesCard.njk" import addressesCard %}
{% from "partials/phoneNumbersCard.njk" import phoneNumbersCard %}
{% from "partials/emailAddressesCard.njk" import emailAddressesCard %}

{% set pageTitle = applicationName + " - Court Details" %}


{% macro confirmationPanel(message, attribute) %}
  <div data-qa="{{ attribute }}" class="govuk-panel govuk-panel--confirmation">
    <div class="govuk-panel__body">
      {{ message }}
    </div>
  </div>
{% endmacro %}

{% block content %}
  {{ govukBackLink({
    text: "Back",
    href: "/court-register"
  }) }}

  <!--suppress HtmlUnknownTarget -->
  <main class="app-container govuk-body">
    <h1 class="govuk-heading-l">Court details for {{ court.courtName }}</h1>

    {% if action == 'CREATED' %}
      {{ confirmationPanel('Court has been added successfully', 'confirm-created') }}
    {% endif %}
    {% if action == 'UPDATED' %}
      {{ confirmationPanel('Court has been updated successfully', 'confirm-updated') }}
    {% endif %}
    {% if action == 'ACTIVATE' %}
      {{ confirmationPanel('Court has been successfully activated', 'confirm-court-activation') }}
    {% endif %}
    {% if action == 'DEACTIVATE' %}
      {{ confirmationPanel('Court has been successfully marked as closed', 'confirm-court-deactivation') }}
    {% endif %}

  <div>
    <h2 class="flush-left govuk-heading-m govuk-grid-column-one-half">Court details</h2>
  </div>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{  courtCoreDetailsCard({ court: court }) }}
    </div>
    <div class="govuk-grid-column-two-thirds">
      {{  courtAreaDetailsCard({ court: court }) }}
    </div>

    <div class="govuk-grid-column-two-thirds">
    </div>
    <div class="govuk-grid-column-two-thirds">
      {{  addressesCard({ addresses: court.addresses, id: court.courtId, baseRegisterUrl: "/court-register" }) }}
    </div>
    <div class="govuk-grid-column-two-thirds">
      {{  phoneNumbersCard({ phoneNumbers: court.phoneNumbers, id: court.courtId, baseRegisterUrl: "/court-register" }) }}
    </div>
    <div class="govuk-grid-column-two-thirds">
      {{  emailAddressesCard({ emailAddresses: court.emailAddresses, id: court.courtId, baseRegisterUrl: "/court-register" }) }}
    </div>
  </div>
  {% if agencyRegistersDeleteEnabled %}
    {{ govukButton({
      text: "Delete court",
      href: "/court-register/delete?id=" + court.courtId,
      classes: "govuk-button--warning",
      attributes: { "data-qa": "delete-court-button" }
    }) }}
  {% endif %}
  </main>

{% endblock %}
