{% extends "../../partials/layout.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "partials/court-register/courtCoreDetailsCard.njk" import courtCoreDetailsCard %}

{% set pageTitle = applicationName + " - Court Details" %}


{% macro confirmationPanel(message, attribute) %}
  <div data-qa="{{ attribute }}" class="govuk-panel govuk-panel--confirmation">
    <div class="govuk-panel__body">
      {{ message }}
    </div>
  </div>
{% endmacro %}

{% block content %}
  {{ govukBackLink({
    text: "Back",
    href: "/court-register"
  }) }}

  <!--suppress HtmlUnknownTarget -->
  <main class="app-container govuk-body">
    <h1 class="govuk-heading-l">{{ court.name }}</h1>

    {% if action == 'UPDATED' %}
      {{ confirmationPanel('Court has been updated successfully', 'confirm-updated') }}
    {% endif %}
    {% if action == 'ACTIVATE' %}
      {{ confirmationPanel('Court has been successfully activated', 'confirm-court-activation') }}
    {% endif %}
    {% if action == 'DEACTIVATE' %}
      {{ confirmationPanel('Court has been successfully marked as closed', 'confirm-court-deactivation') }}
    {% endif %}

  <div>
    <h2 class="flush-left govuk-heading-m govuk-grid-column-one-half">Court details</h2>
  </div>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{  courtCoreDetailsCard({ court: court }) }}
    </div>
  </div>
  </main>

{% endblock %}
