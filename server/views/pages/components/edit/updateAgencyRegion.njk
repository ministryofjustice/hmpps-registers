{% extends "partials/layout.njk" %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% set mainClasses = "app-container govuk-body" %}
{% set pageTitle = "Update region - DPS" %}
{% set title = "Update region for " + name %}

{% block content %}
  {% if errors.length > 0 %}
    {{ govukErrorSummary({ titleText: "There is a problem", errorList: errors }) }}
  {% endif %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">Update region</span>
      <h1 class="govuk-heading-l" data-qa="main-heading">{{ title }}</h1>
      <form method="post">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <input type="hidden" id="regionCode" name="regionCode" value="{{ form.regionCode }}" />
        {{ govukInput({
          id: "region",
          name: "regionDescription",
          label: { text: "Region (optional)" },
          hint: { text: "Start typing a region name and select a suggestion. Clear the field to remove the region." },
          value: form.regionDescription,
          errorMessage: errors | findError('region')
        }) }}
        <p id="region-search-status" role="status" class="govuk-body"></p>
        <div class="govuk-button-group">
          {{ govukButton({
            text: "Confirm and save",
            attributes: {"data-qa": "continue-button"},
            preventDoubleClick: true
          }) }}
          <a class="govuk-link govuk-link--no-visited-state" href="{{ navigation.cancelButton }}" data-qa="cancel-button">Cancel</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}
{% block javascripts %}
  <script src="/assets/accessible-autocomplete.min.js"></script>
  <script src="/assets/js/autoCompleteRegion.js"></script>
{% endblock %}
