{% extends "partials/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% set mainClasses = "app-container govuk-body" %}
{% set pageTitle = "Delete " + agencyType + " - DPS" %}

{% block content %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <span class="govuk-caption-l">Delete {{ agencyType }}</span>
            <h1 class="govuk-heading-l" data-qa="main-heading">Delete {{ name }}</h1>
            <p class="govuk-body">Are you sure you want to delete this {{ agencyType }}? This will also delete its addresses, email addresses and phone numbers. This cannot be undone.</p>
            {{ govukSummaryList({
                attributes: { "data-qa": "agency-details-section" },
                rows: [
                    { key: { text: "Code" }, value: { text: agencyId } },
                    { key: { text: "Name" }, value: { text: name } }
                ]
            }) }}
            <form method="post">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <div class="govuk-button-group">
                    {% if agencyRegistersDeleteEnabled %}
                        {{ govukButton({
                            text: "Delete",
                            classes: "govuk-button--warning",
                            preventDoubleClick: true,
                            attributes: { "data-qa": "delete-agency-button" }
                        }) }}
                    {% endif %}
                    <a class="govuk-link govuk-link--no-visited-state govuk-!-font-size-19" href="{{ navigation.cancelButton }}" data-qa="cancel-button">Cancel</a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
