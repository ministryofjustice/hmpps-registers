{% extends "partials/layout.njk" %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set mainClasses = "app-container govuk-body" %}

{% set pageTitle = "Update email address - DPS" %}
{% set title = "Update email address for " + (name) %}


{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">Update email address</span>
      <h1 class="govuk-heading-l" data-qa="main-heading">{{ title }}</h1>
      <form method="post">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <input type="hidden" name="emailId" value="{{ emailId }}" />
        {{ govukInput({
          id: "emailAddress",
          name: "emailAddress",
          label: { text: "Email address" },
          classes: "govuk-input--width-20",
          value: emailAddress,
          errorMessage: errors | findError('emailAddress'),
          attributes: {
            "data-id": "emailAddress",
            "data-name": "emailAddress",
            "data-qa": "emailAddress"
          }
        }) }}
        <div class="govuk-button-group">
          {{ govukButton({
            text: "Confirm and save",
            name: "save",
            type: "submit",
            classes: 'govuk-!-margin-top-6',
            attributes: {"data-qa": "continue-button"},
            preventDoubleClick: true
          }) }}
          <a class="govuk-link govuk-link--no-visited-state govuk-!-font-size-19" href="{{ navigation.cancelButton }}" data-qa="cancel-button">Cancel</a>
        </div>
      </form>
    </div>
  </div>

{% endblock %}
