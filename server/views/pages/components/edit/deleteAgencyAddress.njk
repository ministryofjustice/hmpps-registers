{% extends "partials/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% set mainClasses = "app-container govuk-body" %}
{% set pageTitle = "Delete address - DPS" %}
{% set title = "Delete address for " + name %}

{% block content %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <span class="govuk-caption-l">Delete address</span>
            <h1 class="govuk-heading-l" data-qa="main-heading">{{ title }}</h1>
            <form method="post">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <input type="hidden" name="addressId" value="{{ address.id }}" />
                {{ govukSummaryList({
                    attributes: { "data-qa": "address-details-section" },
                    rows: [{
                        key: { text: "Address" },
                        value: { html: address | addressToLines | escape | nl2br }
                    }]
                }) }}
                <div class="govuk-button-group">
                    {{ govukButton({
                        text: "Delete address",
                        classes: "govuk-button--warning",
                        preventDoubleClick: true
                    }) }}
                    <a class="govuk-link govuk-link--no-visited-state govuk-!-font-size-19" href="{{ navigation.cancelButton }}" data-qa="cancel-button">Cancel</a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
