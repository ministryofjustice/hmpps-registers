{% extends "partials/layout.njk" %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% set mainClasses = "app-container govuk-body" %}
{% set pageTitle = "Update local authority - DPS" %}
{% set title = "Update local authority for " + name %}

{% block content %}
  {% if errors.length > 0 %}
    {{ govukErrorSummary({ titleText: "There is a problem", errorList: errors }) }}
  {% endif %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">Update local authority</span>
      <h1 class="govuk-heading-l" data-qa="main-heading">{{ title }}</h1>
      <form method="post">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <input type="hidden" id="localAuthorityCode" name="localAuthorityCode" value="{{ form.localAuthorityCode }}" />
        {{ govukInput({
          id: "localAuthority",
          name: "localAuthorityDescription",
          label: { text: "Local authority (optional)" },
          hint: { text: "Start typing a local authority name and select a suggestion. Clear the field to remove the local authority." },
          value: form.localAuthorityDescription,
          errorMessage: errors | findError('localAuthority')
        }) }}
        <p id="localAuthority-search-status" role="status" class="govuk-body"></p>
        <div class="govuk-button-group">
          {{ govukButton({
            text: "Confirm and save",
            attributes: {"data-qa": "continue-button"},
            preventDoubleClick: true
          }) }}
          <a class="govuk-link govuk-link--no-visited-state" href="{{ navigation.cancelButton }}" data-qa="cancel-button">Cancel</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}
{% block javascripts %}
  <script src="/assets/accessible-autocomplete.min.js"></script>
  <script src="/assets/js/autoCompleteLocalAuthority.js"></script>
{% endblock %}
