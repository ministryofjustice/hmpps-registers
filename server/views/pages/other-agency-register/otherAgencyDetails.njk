{% extends "../../partials/layout.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "partials/other-agency-register/otherAgencyCoreDetailsCard.njk" import otherAgencyCoreDetailsCard %}
{% from "partials/other-agency-register/otherAgencyAreaDetailsCard.njk" import otherAgencyAreaDetailsCard %}
{% from "partials/addressesCard.njk" import addressesCard %}
{% from "partials/phoneNumbersCard.njk" import phoneNumbersCard %}
{% from "partials/emailAddressesCard.njk" import emailAddressesCard %}

{% set pageTitle = applicationName + " - Other Agency Details" %}

{% block content %}
  {{ govukBackLink({
    text: "Back",
    href: "/other-agency-register"
  }) }}

  <!--suppress HtmlUnknownTarget -->
  <main class="app-container govuk-body">
    <h1 class="govuk-heading-l">{{ otherAgency.agencyName }}</h1>

  <div>
    <h2 class="flush-left govuk-heading-m govuk-grid-column-one-half">Other agency details</h2>
  </div>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{  otherAgencyCoreDetailsCard({ otherAgency: otherAgency }) }}
    </div>
    <div class="govuk-grid-column-two-thirds">
      {{  otherAgencyAreaDetailsCard({ otherAgency: otherAgency }) }}
    </div>

    <div class="govuk-grid-column-two-thirds">
    </div>
    <div class="govuk-grid-column-two-thirds">
      {{  addressesCard({ addresses: otherAgency.addresses }) }}
    </div>
    <div class="govuk-grid-column-two-thirds">
      {{  phoneNumbersCard({ phoneNumbers: otherAgency.phoneNumbers }) }}
    </div>
    <div class="govuk-grid-column-two-thirds">
      {{  emailAddressesCard({ emailAddresses: otherAgency.emailAddresses }) }}
    </div>
  </div>
  </main>

{% endblock %}
