{% extends "../../partials/layout.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "partials/other-agency-register/otherAgencyCoreDetailsCard.njk" import otherAgencyCoreDetailsCard %}
{% from "partials/other-agency-register/otherAgencyAreaDetailsCard.njk" import otherAgencyAreaDetailsCard %}
{% from "partials/addressesCard.njk" import addressesCard %}
{% from "partials/phoneNumbersCard.njk" import phoneNumbersCard %}
{% from "partials/emailAddressesCard.njk" import emailAddressesCard %}

{% set pageTitle = applicationName + " - Other Agency Details" %}

{% block content %}
  {{ govukBackLink({
    text: "Back",
    href: "/other-agency-register"
  }) }}

  <!--suppress HtmlUnknownTarget -->
  <main class="app-container govuk-body">
    <h1 class="govuk-heading-l">{{ otherAgency.agencyName }}</h1>

    {% if action == 'CREATED' %}
      <div data-qa="confirm-created" class="govuk-panel govuk-panel--confirmation">
        <div class="govuk-panel__body">
          Other agency has been added successfully
        </div>
      </div>
    {% endif %}
    {% if action == 'UPDATED' %}
      <div data-qa="confirm-updated" class="govuk-panel govuk-panel--confirmation">
        <div class="govuk-panel__body">
          Other agency has been updated successfully
        </div>
      </div>
    {% endif %}

  <div>
    <h2 class="flush-left govuk-heading-m govuk-grid-column-one-half">Other agency details</h2>
  </div>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{  otherAgencyCoreDetailsCard({ otherAgency: otherAgency }) }}
    </div>
    <div class="govuk-grid-column-two-thirds">
      {{  otherAgencyAreaDetailsCard({ otherAgency: otherAgency }) }}
    </div>

    <div class="govuk-grid-column-two-thirds">
    </div>
    <div class="govuk-grid-column-two-thirds">
      {{  addressesCard({ addresses: otherAgency.addresses, id: otherAgency.agencyId, baseRegisterUrl: "/other-agency-register" }) }}
    </div>
    <div class="govuk-grid-column-two-thirds">
      {{  phoneNumbersCard({ phoneNumbers: otherAgency.phoneNumbers, id: otherAgency.agencyId, baseRegisterUrl: "/other-agency-register", deleteHidden: true }) }}
    </div>
    <div class="govuk-grid-column-two-thirds">
      {{  emailAddressesCard({ emailAddresses: otherAgency.emailAddresses, id: otherAgency.agencyId, baseRegisterUrl: "/other-agency-register", deleteHidden: true }) }}
    </div>
  </div>
  {% if agencyRegistersDeleteEnabled %}
    {{ govukButton({
      text: "Delete other agency",
      href: "/other-agency-register/delete?id=" + otherAgency.agencyId,
      classes: "govuk-button--warning",
      attributes: { "data-qa": "delete-other-agency-button" }
    }) }}
  {% endif %}
  </main>

{% endblock %}
