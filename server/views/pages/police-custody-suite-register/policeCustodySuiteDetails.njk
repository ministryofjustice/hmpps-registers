{% extends "../../partials/layout.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "partials/police-custody-suite-register/policeCustodySuiteCoreDetailsCard.njk" import policeCustodySuiteCoreDetailsCard %}
{% from "partials/police-custody-suite-register/policeCustodySuiteAreaDetailsCard.njk" import policeCustodySuiteAreaDetailsCard %}
{% from "partials/addressesCard.njk" import addressesCard %}
{% from "partials/phoneNumbersCard.njk" import phoneNumbersCard %}
{% from "partials/emailAddressesCard.njk" import emailAddressesCard %}

{% set pageTitle = applicationName + " - Police Custody Suite Details" %}

{% block content %}
  {{ govukBackLink({
    text: "Back",
    href: "/police-custody-suite-register"
  }) }}

  <!--suppress HtmlUnknownTarget -->
  <main class="app-container govuk-body">
    <h1 class="govuk-heading-l">{{ policeCustodySuite.policeCustodySuiteName }}</h1>

  <div>
    <h2 class="flush-left govuk-heading-m govuk-grid-column-one-half">Police custody suite details</h2>
  </div>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{  policeCustodySuiteCoreDetailsCard({ policeCustodySuite: policeCustodySuite }) }}
    </div>
    <div class="govuk-grid-column-two-thirds">
      {{  policeCustodySuiteAreaDetailsCard({ policeCustodySuite: policeCustodySuite }) }}
    </div>
    <div class="govuk-grid-column-two-thirds">
      {{  addressesCard({ addresses: policeCustodySuite.addresses }) }}
    </div>
    <div class="govuk-grid-column-two-thirds">
      {{  phoneNumbersCard({ phoneNumbers: policeCustodySuite.phoneNumbers }) }}
    </div>
    <div class="govuk-grid-column-two-thirds">
      {{  emailAddressesCard({ emailAddresses: policeCustodySuite.emailAddresses }) }}
    </div>
  </div>
  </main>

{% endblock %}
