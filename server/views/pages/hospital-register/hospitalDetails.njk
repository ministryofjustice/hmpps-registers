{% extends "../../partials/layout.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "partials/hospital-register/hospitalCoreDetailsCard.njk" import hospitalCoreDetailsCard %}
{% from "partials/hospital-register/hospitalAreaDetailsCard.njk" import hospitalAreaDetailsCard %}
{% from "partials/addressesCard.njk" import addressesCard %}
{% from "partials/phoneNumbersCard.njk" import phoneNumbersCard %}

{% set pageTitle = applicationName + " - Hospital Details" %}

{% block content %}
  {{ govukBackLink({
    text: "Back",
    href: "/hospital-register"
  }) }}

  <!--suppress HtmlUnknownTarget -->
  <main class="app-container govuk-body">
    <h1 class="govuk-heading-l">{{ hospital.hospitalName }}</h1>

  <div>
    <h2 class="flush-left govuk-heading-m govuk-grid-column-one-half">Hospital details</h2>
  </div>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{  hospitalCoreDetailsCard({ hospital: hospital }) }}
    </div>
    <div class="govuk-grid-column-two-thirds">
      {{  hospitalAreaDetailsCard({ hospital: hospital }) }}
    </div>
    <div class="govuk-grid-column-two-thirds">
      {{  addressesCard({ addresses: hospital.addresses }) }}
    </div>
    <div class="govuk-grid-column-two-thirds">
      {{  phoneNumbersCard({ phoneNumbers: hospital.phoneNumbers }) }}
    </div>
  </div>
  </main>

{% endblock %}
