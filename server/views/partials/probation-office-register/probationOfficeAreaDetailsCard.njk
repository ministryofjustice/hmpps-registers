{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% macro probationOfficeAreaDetailsCard(opts) %}

  {% set probationOffice = opts.probationOffice %}
  {% set base = "/probation-office-register" %}
  {% set id = probationOffice.probationOfficeId %}

  {{ govukSummaryList({
    card: {
      classes: 'summary-card-wider-key-column',
      title: {
        text: 'Area and region details'
      }
    },
    rows: [
      {
        key: {
          text: 'Area'
        },
        value: {
          text: probationOffice.area.description if probationOffice.area else 'Not provided'
        },
        actions: {
         items: [{
            href: base + "/area/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "area",
            attributes: {"data-qa": "update-area-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Subarea'
        },
        value: {
          text: probationOffice.subarea.description if probationOffice.subarea else 'Not provided'
        },
        actions: {
        items: [ ]
        }
      },
      {
        key: {
          text: 'Region'
        },
        value: {
          text: probationOffice.region.description if probationOffice.region else 'Not provided'
        },
        actions: {
        items: [{
            href: base + "/region/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "region",
            attributes: {"data-qa": "update-region-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Geographical area'
        },
        value: {
        text: probationOffice.geographicalArea.description if probationOffice.geographicalArea else 'Not provided'
        },
        actions: {
          items: [{
            href: base + "/geographical-area/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "geographical area",
            attributes: {"data-qa": "update-geographical-area-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Local Authority'
        },
        value: {
          text: probationOffice.localAuthority.description if probationOffice.localAuthority else 'Not provided'
        },
        actions: {
        items: [{
            href: base + "/local-authority/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "local authority",
            attributes: {"data-qa": "update-local-authority-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Payroll region'
        },
        value: {
          text: probationOffice.payrollRegion.description if probationOffice.payrollRegion else 'Not provided'
        },
        actions: {
        items: [{
            href: base + "/payroll-region/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "payroll region",
            attributes: {"data-qa": "update-payroll-region-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      }
    ]
  }) }}
{% endmacro %}
