{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% macro probationOfficeCoreDetailsCard(opts) %}

  {% set probationOffice = opts.probationOffice %}
  {% set base = "/probation-office-register" %}
  {% set id = probationOffice.probationOfficeId %}

  {{ govukSummaryList({
    card: {
      classes: 'summary-card-wider-key-column',
      title: {
        text: 'Main details'
      }
    },
    rows: [
      {
        key: {
          text: 'Code'
        },
        value: {
          text: probationOffice.probationOfficeId
        },
        actions: {
         items: [ ]
        }
      },
      {
        key: {
          text: 'Name'
        },
        value: {
          text: probationOffice.probationOfficeName
        },
        actions: {
         items: [{
            href: base + "/name-description/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "name",
            attributes: {"data-qa": "update-name-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Description'
        },
        value: {
          text: probationOffice.description if probationOffice.description else 'Not provided'
        },
        actions: {
        items: [{
            href: base + "/name-description/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "description",
            attributes: {"data-qa": "update-description-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Contact'
        },
        value: {
          text: probationOffice.contact if probationOffice.contact else 'Not provided'
        },
        actions: {
        items: [{
            href: base + "/contact/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "contact",
            attributes: {"data-qa": "update-contact-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Active'
        },
        value: {
        text: 'Active' if probationOffice.active else 'Inactive'
        },
        actions: {
          items: [{
            href: base + "/active/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "active status",
            attributes: {"data-qa": "update-active-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Date deactivated'
        },
        value: {
          text: probationOffice.inactiveDate | formatDate
        },
        actions: {
        items: [{
            href: base + "/active/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "date deactivated",
            attributes: {"data-qa": "update-inactive-date-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      } if probationOffice.inactiveDate,
      {
        key: {
          text: 'CJIT Code'
        },
        value: {
          text: probationOffice.cjitCode if probationOffice.cjitCode else 'Not provided'
        },
        actions: {
        items: [{
            href: base + "/cjit-code/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "CJIT code",
            attributes: {"data-qa": "update-cjit-code-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Accessible access'
        },
        value: {
          text: probationOffice.accessibleAccess | accessibleAccessDescription
        },
        actions: {
        items: [{
            href: base + "/accessible-access/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "accessible access",
            attributes: {"data-qa": "update-accessible-access-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      }
    ]
  }) }}
{% endmacro %}
