{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% macro hospitalAreaDetailsCard(opts) %}

  {% set hospital = opts.hospital %}

  {{ govukSummaryList({
    card: {
      classes: 'summary-card-wider-key-column',
      title: {
        text: 'Area and region details'
      }
    },
    rows: [
      {
        key: {
          text: 'Area'
        },
        value: {
          text: hospital.area.description if hospital.area else 'Not provided'
        },
        actions: {
          items: [{
            href: "/hospital-register/area/update?id=" + hospital.hospitalId,
            text: "Update",
            visuallyHiddenText: "area",
            attributes: {"data-qa": "update-area-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Region'
        },
        value: {
          text: hospital.region.description if hospital.region else 'Not provided'
        },
        actions: {
          items: [{
            href: "/hospital-register/region/update?id=" + hospital.hospitalId,
            text: "Update",
            visuallyHiddenText: "region",
            attributes: {"data-qa": "update-region-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Geographical area'
        },
        value: {
          text: hospital.geographicalArea.description if hospital.geographicalArea else 'Not provided'
        },
        actions: {
          items: [{
            href: "/hospital-register/geographical-area/update?id=" + hospital.hospitalId,
            text: "Update",
            visuallyHiddenText: "geographical area",
            attributes: {"data-qa": "update-geographical-area-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Local Authority'
        },
        value: {
          text: hospital.localAuthority.description if hospital.localAuthority else 'Not provided'
        },
        actions: {
          items: [{
            href: "/hospital-register/local-authority/update?id=" + hospital.hospitalId,
            text: "Update",
            visuallyHiddenText: "local authority",
            attributes: {"data-qa": "update-local-authority-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Payroll region'
        },
        value: {
          text: hospital.payrollRegion.description if hospital.payrollRegion else 'Not provided'
        },
        actions: {
          items: [{
            href: "/hospital-register/payroll-region/update?id=" + hospital.hospitalId,
            text: "Update",
            visuallyHiddenText: "payroll region",
            attributes: {"data-qa": "update-payroll-region-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      }
    ]
  }) }}
{% endmacro %}
