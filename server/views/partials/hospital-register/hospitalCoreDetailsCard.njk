{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% macro hospitalCoreDetailsCard(opts) %}

  {% set hospital = opts.hospital %}

  {{ govukSummaryList({
    card: {
      classes: 'summary-card-wider-key-column',
      title: {
        text: 'Main details'
      }
    },
    rows: [
      {
        key: {
          text: 'Code'
        },
        value: {
          text: hospital.hospitalId
        },
        actions: {
          items: [ ]
        }
      },
      {
        key: {
          text: 'Name'
        },
        value: {
          text: hospital.hospitalName
        },
        actions: {
          items: [{
            href: "/hospital-register/name-description/update?id=" + hospital.hospitalId,
            text: "Update",
            visuallyHiddenText: "name",
            attributes: {"data-qa": "update-name-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Description'
        },
        value: {
          text: hospital.description if hospital.description else 'Not provided'
        },
        actions: {
          items: [{
            href: "/hospital-register/name-description/update?id=" + hospital.hospitalId,
            text: "Update",
            visuallyHiddenText: "description",
            attributes: {"data-qa": "update-description-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Active'
        },
        value: {
          text: 'Active' if hospital.active else 'Inactive'
        },
        actions: {
          items: [{
            href: "/hospital-register/active/update?id=" + hospital.hospitalId,
            text: "Update",
            visuallyHiddenText: "active status",
            attributes: {"data-qa": "update-active-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Date deactivated'
        },
        value: {
          text: hospital.inactiveDate | formatDate
        },
        actions: {
          items: [{
            href: "/hospital-register/active/update?id=" + hospital.hospitalId,
            text: "Update",
            visuallyHiddenText: "date deactivated",
            attributes: {"data-qa": "update-inactive-date-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      } if hospital.inactiveDate,
      {
        key: {
          text: 'High security'
        },
        value: {
          text: 'Yes' if hospital.highSecurity else 'No'
        },
        actions: {
          items: [{
            href: "/hospital-register/high-security/update?id=" + hospital.hospitalId,
            text: "Update",
            visuallyHiddenText: "high security",
            attributes: {"data-qa": "update-high-security-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'CJIT Code'
        },
        value: {
          text: hospital.cjitCode if hospital.cjitCode else 'Not provided'
        },
        actions: {
          items: [{
            href: "/hospital-register/cjit-code/update?id=" + hospital.hospitalId,
            text: "Update",
            visuallyHiddenText: "CJIT code",
            attributes: {"data-qa": "update-cjit-code-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      }
    ]
  }) }}
{% endmacro %}
