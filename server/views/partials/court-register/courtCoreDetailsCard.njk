{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% macro courtCoreDetailsCard(opts) %}

  {% set court = opts.court %}


  {{ govukSummaryList({
    card: {
      classes: 'summary-card-wider-key-column',
      title: {
        text: 'Main details'
      }
    },
    rows: [
      {
        key: {
        text: 'Code'
      },
        value: {
        text: court.courtId
      },
        actions: {
        items: [ ]
        }
      },
      {
        key: {
          text: 'Name'
        },
        value: {
          text: court.courtName
        },
        actions: {
          items: [
            {
              href: "/court-register/name-description/update?id=" + court.courtId,
              text: "Update",
              visuallyHiddenText: "name",
              attributes: {"data-qa": "update-name-link"},
              classes: "govuk-link--no-visited-state"
            }
          ]
        }
      },
      {
        key: {
          text: 'Description'
        },
        value: {
          text: court.description
        },
        actions: {
          items: [
            {
              href: "/court-register/name-description/update?id=" + court.courtId,
              text: "Update",
              visuallyHiddenText: "description",
              attributes: {"data-qa": "update-description-link"},
              classes: "govuk-link--no-visited-state"
            }
          ]
        }
      },
      {
        key: {
          text: 'Active'
        },
        value: {
        text: 'Active' if court.active else 'Inactive'
        },
        actions: {
          items: [ ]
        }
      },
      {
        key: {
          text: 'Date deactivated'
        },
        value: {
          text: court.inactiveDate | formatDate
        },
        actions: {
        items: [ ]
        }
      } if court.inactiveDate,
      {
        key: {
          text: 'Court Type'
        },
        value: {
          text: court.courtType.description if court.courtType else 'Not provided'
        },
        actions: {
          items: [
            {
              href: "/court-register/court-type/update?id=" + court.courtId,
              text: "Update",
              visuallyHiddenText: "court type",
              attributes: {"data-qa": "update-court-type-link"},
              classes: "govuk-link--no-visited-state"
            }
          ]
        }
      },
      {
        key: {
          text: 'Accessible access'
        },
        value: {
          text: court.accessibleAccess | accessibleAccessDescription
        },
        actions: {
          items: [
            {
              href: "/court-register/accessible-access/update?id=" + court.courtId,
              text: "Update",
              visuallyHiddenText: "accessible access",
              attributes: {"data-qa": "update-accessible-access-link"},
              classes: "govuk-link--no-visited-state"
            }
          ]
        }
      },
      {
        key: {
          text: 'CJIT Code'
        },
        value: {
          text: court.cjitCode if court.cjitCode else 'Not provided'
        },
        actions: {
        items: [ ]
        }
      }
    ]
  }) }}
{% endmacro %}
