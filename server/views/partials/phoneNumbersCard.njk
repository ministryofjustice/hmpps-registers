{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% macro phoneNumbersCard(opts) %}

  {% set phoneNumbers = opts.phoneNumbers %}
  {% set baseRegisterUrl = opts.baseRegisterUrl %}
  {% set id = opts.id %}
  {% set data = [] %}

  {% if phoneNumbers and phoneNumbers.length > 0 %}
    {% for item in phoneNumbers %}
      {% set data = data.concat([{
        key: {
          text: "Number"
        },
        value: {
          text: item.number
        },
        actions: {
          items: [
            {
              href: baseRegisterUrl + "/phone/update?id=" + id + "&phoneId=" + item.id,
              text: "Update",
              visuallyHiddenText: "phone number " + item.number,
              attributes: {"data-qa": "update-phone-number-link"},
              classes: "govuk-link--no-visited-state"
            }
          ] if baseRegisterUrl else []
        }
      }]) %}
    {% endfor %}
  {% else %}
    {% set data = data.concat([{
      key: {
        text: 'No phone numbers provided.',
        classes: 'govuk-!-font-weight-regular govuk-!-width-full'
      }
    }]) %}
  {% endif %}

  {{ govukSummaryList({
    card: {
      classes: 'summary-card-wider-key-column',
      title: {
        text: "Phone numbers"
      },
      actions: {
        items: [
          {
            href: baseRegisterUrl + "/phone/create?id=" + id,
            text: "Add phone number",
            attributes: {"data-qa": "add-phone-number-link"},
            classes: "govuk-link--no-visited-state"
          }
        ] if baseRegisterUrl else []
        }
    },
    rows: data
  }) }}
{% endmacro %}
