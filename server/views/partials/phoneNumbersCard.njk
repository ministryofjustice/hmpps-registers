{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% macro phoneNumbersCard(opts) %}

  {% set phoneNumbers = opts.phoneNumbers %}
  {% set data = [] %}

  {% if phoneNumbers and phoneNumbers.length > 0 %}
    {% for item in phoneNumbers %}
      {% set data = data.concat([{
        key: {
          text: "Number"
        },
        value: {
          text: item.number
        },
        actions: {
          items: []
        }
      }]) %}
    {% endfor %}
  {% else %}
    {% set data = data.concat([{
      key: {
        text: 'No phone numbers provided.',
        classes: 'govuk-!-font-weight-regular govuk-!-width-full'
      }
    }]) %}
  {% endif %}

  {{ govukSummaryList({
    card: {
      classes: 'summary-card-wider-key-column',
      title: {
        text: "Phone numbers"
      },
      actions: {
        items: []
        }
    },
    rows: data
  }) }}
{% endmacro %}
