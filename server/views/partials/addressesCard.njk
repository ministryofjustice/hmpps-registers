{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% macro addressesCard(opts) %}

  {% set addresses = opts.addresses %}
  {% set baseRegisterUrl = opts.baseRegisterUrl %}
  {% set id = opts.id %}
  {% set data = [] %}


  {% if addresses and addresses.length > 0 %}
    {% for item in addresses %}
      {% set actions = [{
        href: baseRegisterUrl + "/address/update?id=" + id + "&addressId=" + item.id,
        text: "Update",
        visuallyHiddenText: "address " + (item | addressToLines),
        attributes: {"data-qa": "update-address-link"},
        classes: "govuk-link--no-visited-state"
      }] %}
      {% if opts.deleteEnabled %}
        {% set actions = actions.concat([{
          href: baseRegisterUrl + "/address/delete?id=" + id + "&addressId=" + item.id,
          text: "Delete",
          visuallyHiddenText: "address " + (item | addressToLines),
          attributes: {"data-qa": "delete-address-link"},
          classes: "govuk-link--no-visited-state"
        }]) %}
      {% endif %}
      {% set data = data.concat([{

        key: {
          text: "Address"
        },
        value: {
          html: item | addressToLines | escape | nl2br
        },
        actions: {
          items: actions if baseRegisterUrl else []
        }
      }]) %}
    {% endfor %}
  {% else %}
    {% set data = data.concat([{
      key: {
        text: 'No addresses provided.',
        classes: 'govuk-!-font-weight-regular govuk-!-width-full'
      }
    }]) %}
  {% endif %}

  {{ govukSummaryList({
    card: {
      classes: 'summary-card-wider-key-column',
      title: {
        text: "Addresses"
      },
      actions: {
        items: [
          {
            href: baseRegisterUrl + "/address/create?id=" + id,
            text: "Add address",
            attributes: {"data-qa": "add-address-link"},
            classes: "govuk-link--no-visited-state"
          }
        ] if baseRegisterUrl else []
      }
    },
    rows: data
  }) }}
{% endmacro %}
