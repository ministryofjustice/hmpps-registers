{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% macro otherAgencyCoreDetailsCard(opts) %}

  {% set otherAgency = opts.otherAgency %}
  {% set base = "/other-agency-register" %}
  {% set id = otherAgency.agencyId %}

  {{ govukSummaryList({
    card: {
      classes: 'summary-card-wider-key-column',
      title: {
        text: 'Main details'
      }
    },
    rows: [
      {
        key: {
          text: 'Code'
        },
        value: {
          text: otherAgency.agencyId
        },
        actions: {
         items: [ ]
        }
      },
      {
        key: {
          text: 'Name'
        },
        value: {
          text: otherAgency.agencyName
        },
        actions: {
         items: [{
            href: base + "/name-description/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "name",
            attributes: {"data-qa": "update-name-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Description'
        },
        value: {
          text: otherAgency.description if otherAgency.description else 'Not provided'
        },
        actions: {
        items: [{
            href: base + "/name-description/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "description",
            attributes: {"data-qa": "update-description-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Active'
        },
        value: {
        text: 'Active' if otherAgency.active else 'Inactive'
        },
        actions: {
          items: [{
            href: base + "/active/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "active status",
            attributes: {"data-qa": "update-active-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Date deactivated'
        },
        value: {
          text: otherAgency.inactiveDate | formatDate
        },
        actions: {
        items: [{
            href: base + "/active/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "date deactivated",
            attributes: {"data-qa": "update-inactive-date-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      } if otherAgency.inactiveDate,
      {
        key: {
          text: 'Other Agency Type'
        },
        value: {
          text: otherAgency.agencyType | otherAgencyTypeDescription
        },
        actions: {
        items: [{
            href: base + "/agency-type/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "other agency type",
            attributes: {"data-qa": "update-agency-type-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Accessible access'
        },
        value: {
          text: otherAgency.accessibleAccess | accessibleAccessDescription
        },
        actions: {
        items: [{
            href: base + "/accessible-access/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "accessible access",
            attributes: {"data-qa": "update-accessible-access-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'CJIT Code'
        },
        value: {
          text: otherAgency.cjitCode if otherAgency.cjitCode else 'Not provided'
        },
        actions: {
        items: [{
            href: base + "/cjit-code/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "CJIT code",
            attributes: {"data-qa": "update-cjit-code-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      }
    ]
  }) }}
{% endmacro %}
