{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% macro policeCustodySuiteAreaDetailsCard(opts) %}

  {% set policeCustodySuite = opts.policeCustodySuite %}
  {% set base = "/police-custody-suite-register" %}
  {% set id = policeCustodySuite.policeCustodySuiteId %}

  {{ govukSummaryList({
    card: {
      classes: 'summary-card-wider-key-column',
      title: {
        text: 'Area and region details'
      }
    },
    rows: [
      {
        key: {
          text: 'Area'
        },
        value: {
          text: policeCustodySuite.area.description if policeCustodySuite.area else 'Not provided'
        },
        actions: {
          items: [{
            href: base + "/area/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "area",
            attributes: {"data-qa": "update-area-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Region'
        },
        value: {
          text: policeCustodySuite.region.description if policeCustodySuite.region else 'Not provided'
        },
        actions: {
          items: [{
            href: base + "/region/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "region",
            attributes: {"data-qa": "update-region-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Geographical area'
        },
        value: {
          text: policeCustodySuite.geographicalArea.description if policeCustodySuite.geographicalArea else 'Not provided'
        },
        actions: {
          items: [{
            href: base + "/geographical-area/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "geographical area",
            attributes: {"data-qa": "update-geographical-area-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Local Authority'
        },
        value: {
          text: policeCustodySuite.localAuthority.description if policeCustodySuite.localAuthority else 'Not provided'
        },
        actions: {
          items: [{
            href: base + "/local-authority/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "local authority",
            attributes: {"data-qa": "update-local-authority-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Payroll region'
        },
        value: {
          text: policeCustodySuite.payrollRegion.description if policeCustodySuite.payrollRegion else 'Not provided'
        },
        actions: {
          items: [{
            href: base + "/payroll-region/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "payroll region",
            attributes: {"data-qa": "update-payroll-region-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      }
    ]
  }) }}
{% endmacro %}
