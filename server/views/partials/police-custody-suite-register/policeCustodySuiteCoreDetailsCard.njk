{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% macro policeCustodySuiteCoreDetailsCard(opts) %}

  {% set policeCustodySuite = opts.policeCustodySuite %}
  {% set base = "/police-custody-suite-register" %}
  {% set id = policeCustodySuite.policeCustodySuiteId %}

  {{ govukSummaryList({
    card: {
      classes: 'summary-card-wider-key-column',
      title: {
        text: 'Main details'
      }
    },
    rows: [
      {
        key: {
          text: 'Code'
        },
        value: {
          text: id
        },
        actions: {
          items: [ ]
        }
      },
      {
        key: {
          text: 'Name'
        },
        value: {
          text: policeCustodySuite.policeCustodySuiteName
        },
        actions: {
          items: [{
            href: base + "/name-description/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "name",
            attributes: {"data-qa": "update-name-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Description'
        },
        value: {
          text: policeCustodySuite.description if policeCustodySuite.description else 'Not provided'
        },
        actions: {
          items: [{
            href: base + "/name-description/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "description",
            attributes: {"data-qa": "update-description-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Active'
        },
        value: {
          text: 'Active' if policeCustodySuite.active else 'Inactive'
        },
        actions: {
          items: [{
            href: base + "/active/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "active status",
            attributes: {"data-qa": "update-active-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Date deactivated'
        },
        value: {
          text: policeCustodySuite.inactiveDate | formatDate
        },
        actions: {
          items: [{
            href: base + "/active/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "date deactivated",
            attributes: {"data-qa": "update-inactive-date-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      } if policeCustodySuite.inactiveDate,
      {
        key: {
          text: 'CJIT Code'
        },
        value: {
          text: policeCustodySuite.cjitCode if policeCustodySuite.cjitCode else 'Not provided'
        },
        actions: {
          items: [{
            href: base + "/cjit-code/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "CJIT code",
            attributes: {"data-qa": "update-cjit-code-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      }
    ]
  }) }}
{% endmacro %}
