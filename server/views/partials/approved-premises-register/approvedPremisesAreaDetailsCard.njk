{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% macro approvedPremisesAreaDetailsCard(opts) %}

  {% set approvedPremises = opts.approvedPremises %}
  {% set base = "/approved-premises-register" %}
  {% set id = approvedPremises.approvedPremisesId %}

  {{ govukSummaryList({
    card: {
      classes: 'summary-card-wider-key-column',
      title: {
        text: 'Area and region details'
      }
    },
    rows: [
      {
        key: {
          text: 'Area'
        },
        value: {
          text: approvedPremises.area.description if approvedPremises.area else 'Not provided'
        },
        actions: {
         items: [{
            href: base + "/area/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "area",
            attributes: {"data-qa": "update-area-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Region'
        },
        value: {
          text: approvedPremises.region.description if approvedPremises.region else 'Not provided'
        },
        actions: {
        items: [{
            href: base + "/region/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "region",
            attributes: {"data-qa": "update-region-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Geographical area'
        },
        value: {
        text: approvedPremises.geographicalArea.description if approvedPremises.geographicalArea else 'Not provided'
        },
        actions: {
          items: [{
            href: base + "/geographical-area/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "geographical area",
            attributes: {"data-qa": "update-geographical-area-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Local Authority'
        },
        value: {
          text: approvedPremises.localAuthority.description if approvedPremises.localAuthority else 'Not provided'
        },
        actions: {
        items: [{
            href: base + "/local-authority/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "local authority",
            attributes: {"data-qa": "update-local-authority-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      },
      {
        key: {
          text: 'Payroll region'
        },
        value: {
          text: approvedPremises.payrollRegion.description if approvedPremises.payrollRegion else 'Not provided'
        },
        actions: {
        items: [{
            href: base + "/payroll-region/update?id=" + id,
            text: "Update",
            visuallyHiddenText: "payroll region",
            attributes: {"data-qa": "update-payroll-region-link"},
            classes: "govuk-link--no-visited-state"
          }]
        }
      }
    ]
  }) }}
{% endmacro %}
